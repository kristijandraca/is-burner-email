<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Kristijandraca.IsBurnerEmail</RootNamespace>
    <AssemblyName>Kristijandraca.IsBurnerEmail</AssemblyName>

    <PackageId>Kristijandraca.IsBurnerEmail</PackageId>
    <Version>1.3.5</Version>
    <Authors>kristijandraca</Authors>
    <Description>Fast, offline burner / disposable email detection with three-list (blacklist/whitelist/graylist) classification.</Description>
    <PackageTags>email;burner;disposable;temporary;validator;offline</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kristijandraca/is-burner-email</PackageProjectUrl>
    <RepositoryUrl>https://github.com/kristijandraca/is-burner-email</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="data/blacklist.txt" LogicalName="blacklist.txt" />
    <EmbeddedResource Include="data/whitelist.txt" LogicalName="whitelist.txt" />
    <EmbeddedResource Include="data/graylist.txt" LogicalName="graylist.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
