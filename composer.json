{
  "name": "kristijandraca/is-burner-email",
  "description": "Fast, offline burner / disposable email detection. Three lists (blacklist, whitelist, graylist), two modes (normal, strict), zero runtime deps. PHP port of is-burner-email.",
  "type": "library",
  "license": "MIT",
  "keywords": ["email", "burner", "disposable", "temporary", "validator", "offline"],
  "homepage": "https://github.com/kristijandraca/is-burner-email",
  "authors": [
    { "name": "kristijandraca" }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Kristijandraca\\IsBurnerEmail\\": "packages/php/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kristijandraca\\IsBurnerEmail\\Tests\\": "packages/php/tests/"
    }
  },
  "bin": ["packages/php/bin/burner"],
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
